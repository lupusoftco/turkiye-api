{
  "name": "lupusoftco/turkiye-api",
  "description": "Open-source REST API for Turkey-specific developer needs: TCMB exchange rates, public holidays & business days, addresses & postal codes, TCKN/VKN/IBAN validation, Turkish text tools, QR codes and link previews.",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "turkey",
    "turkiye",
    "api",
    "tcmb",
    "iban",
    "tckn",
    "holidays",
    "postal-code",
    "qr-code"
  ],
  "authors": [
    {
      "name": "Burak",
      "homepage": "https://lupusoft.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "ext-simplexml": "*",
    "chillerlan/php-qrcode": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "TurkiyeApi\\": "src/"
    },
    "files": [
      "src/compat.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "TurkiyeApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "setup": "php bin/setup.php",
    "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4.33"
    }
  },
  "suggest": {
    "ext-gd": "PNG QR codes (SVG works without it)",
    "ext-intl": "Better ASCII transliteration of non-Turkish characters in slugs; regenerating the bayram table"
  }
}
