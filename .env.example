# All settings are optional; the API works without a .env file.

# Public base URL used in links (no trailing slash). Detected from the request when empty.
APP_URL=
# Sub-directory the API is mounted under, e.g. /api. Detected from index.php when empty.
BASE_PATH=
APP_DEBUG=false
# Secret used to pseudonymise client IPs. Generated into storage/app.key when empty.
APP_KEY=
# Import address data automatically on first use (otherwise run php bin/setup.php)
AUTO_SETUP=true

# SQLite database (relative to the project root or absolute)
DB_PATH=storage/database.sqlite

# Comma-separated list, or * for any origin
CORS_ORIGINS=*
# Set when running behind a reverse proxy / CDN (comma-separated proxy IPs)
TRUSTED_PROXIES=

# Requests per window. Anonymous callers are identified by IP.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ANON=60
RATE_LIMIT_KEY=600
RATE_LIMIT_LINK_PREVIEW=10
RATE_LIMIT_EXCHANGE_HISTORY=20
REQUIRE_API_KEY=false

# Fetch missing TCMB bulletins while serving requests (disable if you only use the cron job)
TCMB_FETCH_ON_DEMAND=true
LINK_PREVIEW_ENABLED=true
USAGE_STATS=true
HTTP_USER_AGENT=
